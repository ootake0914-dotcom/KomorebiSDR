# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller / Build artifacts
build/
dist/
*.spec

# Executables (Publish as GitHub Releases instead of tracking in Git)
*.exe

# Logs and runtime databases
*.log
*.csv
*.db

# OS / Editor generated
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Temporary test / scratch files
scratch/
test_*.png
assets_screenshot_test.png

# Audio recordings and raw IQ captures
*.wav
*.raw
*.iq
*.bin

# Analysis / Debug images (Keep assets/ directory tracked)
*.png
!assets/**/*.png
!assets/*.png

# Native build artifacts / C extensions
*.obj
*.o
*.dll
*.so
*.dylib
