# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller / Build artifacts
build/
dist/
*.spec

# Executables (Publish as GitHub Releases instead of tracking in Git)
*.exe

# Logs and runtime databases
*.log
*.csv
*.db

# OS / Editor generated
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# HTML documents and design mockups
*.html
doc/


# Temporary test / scratch files
scratch/
test_*.png
assets_screenshot_test.png

# Audio recordings and raw IQ captures
*.wav
*.raw
*.iq
*.bin
testdata/day_*.npy
testdata/night_*.npy
testdata/*_rec_*.npy


# Audio AB artefacts (large binaries / local model weights)
audio_ab/out/
audio_ab/models/
audio_ab/tts/

# Analysis / Debug images (Keep assets/ directory tracked)
*.png
!assets/**/*.png
!assets/*.png

# Native build artifacts / C extensions
*.obj
*.o
*.dll
*.so
*.dylib
